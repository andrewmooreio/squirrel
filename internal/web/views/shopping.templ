package views

import "github.com/andrewmooreio/squirrel/internal/store"

// ShoppingGroup is the items on the shopping list for one store.
type ShoppingGroup struct {
	Store string
	Items []store.Item
}

// ShoppingData is everything the shopping list page needs.
type ShoppingData struct {
	Groups []ShoppingGroup
}

templ Shopping(p Page, d ShoppingData) {
	@Layout(p) {
		<div class="grid gap-4">
			<header>
				<h1 class="text-xl font-semibold">Shopping list</h1>
				<p class="text-sm text-muted-foreground">Items you added to the shopping list, grouped by store.</p>
			</header>
			if len(d.Groups) == 0 {
				<section class="empty py-12">
					<header>
						<h2 class="text-lg font-semibold">Nothing to buy</h2>
						<p>Tap the cart on an item to add it to the list.</p>
					</header>
					<a href="/" class="btn" data-variant="outline">Back to the list</a>
				</section>
			} else {
				for _, g := range d.Groups {
					<section class="grid gap-2">
						<h2 class="text-lg font-semibold">{ g.Store }</h2>
						<ul class="grid grid-cols-[minmax(0,1fr)] gap-2 lg:grid-cols-2">
							for _, it := range g.Items {
								@Row(it, "")
							}
						</ul>
					</section>
				}
			}
		</div>
	}
}
