{
  "name": "squirrel",
  "version": "2.0.0",
  "private": true,
  "description": "A self-hosted web app that counts household stock.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run build:static && npm run build:node",
    "build:static": "node scripts/build-static.mjs",
    "build:node": "node scripts/build-node.mjs",
    "start": "node dist/node/server.mjs",
    "dev": "npm run build && DATABASE_URL=${DATABASE_URL:-sqlite://./tmp/squirrel.db} node dist/node/server.mjs",
    "dev:worker": "npm run build:static && wrangler dev",
    "deploy": "npm run build:static && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "pretest": "npm run build:static",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:workers": "vitest run --project workers"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@tailwindcss/cli": "4.3.4",
    "@types/node": "26.6.6",
    "basecoat-css": "1.1.0",
    "esbuild": "0.28.2",
    "htmx.org": "4.0.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16"
  }
}
